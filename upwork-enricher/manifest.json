{
  "manifest_version": 3,
  "name": "Falcon Scout Enricher",
  "version": "3.8",
  "description": "Extracts job data from Upwork job pages and sends to local Falcon Scout dashboard",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.upwork.com/*",
    "http://127.0.0.1/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5174/*",
    "http://127.0.0.1:5174/*",
    "http://localhost:5180/*",
    "http://127.0.0.1:5180/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.upwork.com/jobs/*",
        "https://www.upwork.com/nx/jobs/*",
        "https://www.upwork.com/ab/jobs/*",
        "https://www.upwork.com/nx/s/job-details-viewer/*",
        "https://www.upwork.com/ab/s/job-details-viewer/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.upwork.com/messages/rooms/*",
        "https://www.upwork.com/nx/messages/rooms/*",
        "https://www.upwork.com/ab/messages/rooms/*",
        "https://www.upwork.com/nx/wm/workroom/*/messages*",
        "https://www.upwork.com/ab/wm/workroom/*/messages*"
      ],
      "js": ["messages.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.upwork.com/messages/*",
        "https://www.upwork.com/nx/messages/*",
        "https://www.upwork.com/ab/messages/*"
      ],
      "js": ["messages-list.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.upwork.com/ab/proposals/*",
        "https://www.upwork.com/nx/proposals/*",
        "https://www.upwork.com/nx/wm/workroom/*/proposal*",
        "https://www.upwork.com/ab/wm/workroom/*/proposal*"
      ],
      "js": ["proposal.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:5174/*",
        "http://127.0.0.1:5174/*",
        "http://localhost:5180/*",
        "http://127.0.0.1:5180/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
