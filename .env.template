# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# The Telegram username of the bot to listen to (without @)
BOT_USERNAME=OffersHunterBot

# Path to the SQLite database file
DATABASE_URL=sqlite:///upwork_jobs.db

# Path where Telethon stores its session file
SESSION_NAME=upwork_listener

# Upwork API (read-only public key) — from https://www.upwork.com/developer/keys
# Powers the API job-feed (alternative to the Telegram bot). Probe with:
#   python scripts/upwork_probe.py
UPWORK_API_KEY=your_upwork_api_key_here
UPWORK_API_SECRET=your_upwork_api_secret_here
