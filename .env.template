# Anthropic API key — REQUIRED unless you run entirely in CLI-bridge mode.
# Every /claude, /chat and analyser call reads it; without it the backend answers
# "ANTHROPIC_API_KEY not set in .env" and nothing generates. Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Path to the SQLite database file
DATABASE_URL=sqlite:///upwork_jobs.db

# Where the daily verified database backup is written (tools/backup_db.py, run by
# the backend: first ~60 s after launch, then every 24 h; keeps 14 daily + 8
# weekly). Use a folder OUTSIDE this repo, ideally one that Dropbox / OneDrive
# syncs, so the copy also survives a dead disk. If unset it falls back to
# %USERPROFILE%\FalconScoutBackups. The header shows a red chip if the newest
# backup is missing, failed or older than 48 h.
# BACKUP_DIR=C:\Users\you\Dropbox\FalconScoutBackups

# Port of the local CLI bridge (cli-bridge.js, which routes Claude calls through your
# `claude -p` subscription). The backend and the bridge both read this ONE setting, so
# they cannot disagree. Default 27183. If another program on this machine already
# listens on 27183, set a different free port (1024-65535) and restart the backend.
# An invalid value stops the bridge instead of guessing.
# CLI_BRIDGE_PORT=27183

# Shared secret the backend sends to the CLI bridge (X-Falcon-Token). The bridge
# refuses /ai without it, so other web pages in your browser cannot use your Claude
# subscription. Leave it out: setup.bat and falconscout.bat generate a random one
# (tools/ensure_bridge_token.py). Never share it.
# CLI_BRIDGE_TOKEN=

# Upwork API (read-only public key) — from https://www.upwork.com/developer/keys
# Powers the API job-feed, the only job source. Probe with:
#   python scripts/upwork_probe.py
UPWORK_API_KEY=your_upwork_api_key_here
UPWORK_API_SECRET=your_upwork_api_secret_here
